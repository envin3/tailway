FROM debian:13-slim

ARG PROTON_RELEASE_URL=https://repo.protonvpn.com/debian/dists/stable/main/binary-all/protonvpn-stable-release_1.0.10_all.deb
ARG PROTON_RELEASE_SHA256=c8a9fffb4ebdd63db08ce7f11c9b0ac394064ae6a210feb9ab63a0f7d8d060a7
# Exact versions: keep broker builds reproducible when Proton publishes updates.
ARG PROTON_CORE_VERSION=5.8.11
ARG PROTON_PYTHON_CORE_VERSION=0.7.4

RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates gnupg python3 wget \
    && wget -qO /tmp/proton-release.deb "$PROTON_RELEASE_URL" \
    && echo "$PROTON_RELEASE_SHA256  /tmp/proton-release.deb" | sha256sum --check - \
    && dpkg -i /tmp/proton-release.deb \
    && apt-get update \
    && apt-get install --no-install-recommends -y \
        "python3-proton-vpn-api-core=$PROTON_CORE_VERSION" \
        "python3-proton-core=$PROTON_PYTHON_CORE_VERSION" \
    && python3 -c "import importlib.metadata as m; actual=m.version('proton-vpn-api-core'); expected='$PROTON_CORE_VERSION'; assert actual == expected, f'expected proton-vpn-api-core {expected}, got {actual}'" \
    && rm -rf /var/lib/apt/lists/* /tmp/proton-release.deb

LABEL org.opencontainers.image.title="Tailway Proton broker" \
      org.opencontainers.image.description="Proton VPN account broker for Tailway (unofficial)" \
      org.opencontainers.image.source="https://github.com/envin3/tailway" \
      org.opencontainers.image.licenses="GPL-3.0-or-later"

COPY --chown=65533:1000 proton-broker/proton_broker /app/proton_broker

ENV HOME=/var/lib/proton-broker \
    LOGNAME=proton-broker \
    PYTHONPATH=/app \
    PROTON_BROKER_SOCKET=/run/tailway/proton.sock \
    PROTON_LOADER_OVERRIDES=keyring=json \
    USER=proton-broker \
    XDG_CACHE_HOME=/var/lib/proton-broker/cache \
    XDG_CONFIG_HOME=/var/lib/proton-broker/config \
    XDG_RUNTIME_DIR=/run/tailway/proton-runtime

ENTRYPOINT ["python3", "-m", "proton_broker.server"]
