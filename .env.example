HOST_BIND_IP=192.168.1.10
HOST_TAILSCALE_UDP_PORT=41641
CONTROL_GID=1000
TAILSCALE_VERSION=1.102.1
PROTON_CORE_VERSION=5.6.20
# Image tag to build or run; use the git short hash for test deployments.
IMAGE_TAG=dev
# Route for tailnet nodes without an assignment: block, local, or direct.
UNASSIGNED_POLICY=block
# Per-device DNS forwarder (point the tailnet's DNS server at this gateway).
DNS_FORWARDER=true
DNS_DEFAULT_SERVER=9.9.9.9
DNS_KILL_SWITCH_DEFAULT=true
# Alerts are configured on the console's Alerts page (Telegram and/or a webhook).
# ALERT_WEBHOOK_URL only seeds a webhook until settings are saved there.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=ntfy
ALERT_SOURCE=tailscale-exit-policy-router
